# ─────────────────────────────────────────────────────────────────────────────
# ClearSpend — secrets template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE
#   1. Copy this file to ".streamlit/secrets.toml" (same folder, drop ".example").
#   2. Paste your real key after the "=".
#   3. NEVER commit the real secrets.toml — it is already in .gitignore.
#
# When this key is set, the AI assistant works for EVERYONE who opens the app,
# without each visitor needing to paste their own key.
#
# On Streamlit Community Cloud: don't use a file — open your app →
#   "⋮" menu → Settings → Secrets, and paste the same line there.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Claude (preferred). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional fallback — free Google Gemini key from https://aistudio.google.com/apikey
# GEMINI_API_KEY = "AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
